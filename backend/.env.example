# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB (Atlas free tier works — must be a replica set for transactions) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulseaid

# --- Neo4j (AuraDB free tier — optional, app falls back to Mongo geo if unset) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-password>

# --- JWT ---
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRY=7d